{
  "name": "dsh-session-trash-bin",
  "version": "0.1.0",
  "description": "在会话右键菜单中加入「删除会话（放入回收站）」与「彻底删除会话」，并在侧栏提供可恢复的会话回收站。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QLX-Hub/dsh-config.git",
    "directory": "plugins/dsh-session-trash"
  },
  "homepage": "https://github.com/QLX-Hub/dsh-config/tree/main/plugins/dsh-session-trash#readme",
  "bugs": {
    "url": "https://github.com/QLX-Hub/dsh-config/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "trash",
    "recycle-bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/store.js && node --check lib/client.js",
    "test": "node test/store.test.mjs && node test/http.test.mjs && node test/client.smoke.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "platform": "web"
    }
  }
}
